# Solo gli endpoint pubblici sono raggiungibili: la libreria e le impostazioni no.
<FilesMatch "^(_lib|config|config\.esempio)\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
